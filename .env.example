# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Base de datos (PostgreSQL / Supabase, requiere SSL) ---
# Se usa la primera definida: SUPABASE_POOLER_DATABASE_URL > SUPABASE_DATABASE_URL > DATABASE_URL
SUPABASE_POOLER_DATABASE_URL=postgresql://usuario:contraseña@host:6543/postgres
# SUPABASE_DATABASE_URL=
# DATABASE_URL=

# --- Sesiones (obligatorio en producción) ---
# Clave larga y aleatoria para firmar las cookies de sesión. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si no se define, se usa MANUS_JWT_SECRET. Cambiarla cierra todas las sesiones abiertas.
SESSION_SECRET=

# --- Supervisor inicial ---
# Solo se usa la primera vez, cuando la tabla de supervisores está vacía.
# En producción, si falta la contraseña, se genera una aleatoria y se muestra una vez en el log.
INITIAL_SUPERVISOR_NAME=Supervisor
INITIAL_SUPERVISOR_USERNAME=supervisor
INITIAL_SUPERVISOR_PASSWORD=

# --- URL pública de la app (obligatoria en producción) ---
# Se usa para armar el enlace de los correos de recuperación de contraseña.
APP_URL=https://guardian.agenciaiachile.site

# --- Correo para recuperar contraseñas (Gmail) ---
# SMTP_USER: la cuenta de Gmail que envía los correos.
# SMTP_PASS: la «contraseña de aplicación de Gmail» (16 letras, sin espacios). NO es la contraseña
#            normal de Gmail. Se crea en myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GuardiaFlow <cuenta@gmail.com>

# --- Despliegue con Docker + Nginx (docker-compose.yml) ---
# Puerto local (solo 127.0.0.1) al que Nginx reenvía el tráfico. Debe estar libre.
APP_PORT=3010

# --- Plataforma Manus (opcional; solo si se despliega en Manus) ---
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
# MANUS_OAUTH_API_URL=
# MANUS_API_URL=
# MANUS_API_KEY=
# OWNER_OPEN_ID=
