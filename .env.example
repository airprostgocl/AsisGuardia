# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Base de datos (PostgreSQL / Supabase, requiere SSL) ---
# Se usa la primera definida: SUPABASE_POOLER_DATABASE_URL > SUPABASE_DATABASE_URL > DATABASE_URL
SUPABASE_POOLER_DATABASE_URL=postgresql://usuario:contraseña@host:6543/postgres
# SUPABASE_DATABASE_URL=
# DATABASE_URL=

# --- Sesiones (obligatorio en producción) ---
# Clave larga y aleatoria para firmar las cookies de sesión. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si no se define, se usa MANUS_JWT_SECRET. Cambiarla cierra todas las sesiones abiertas.
SESSION_SECRET=

# --- Supervisor inicial ---
# Solo se usa la primera vez, cuando la tabla de supervisores está vacía.
# En producción, si falta la contraseña, se genera una aleatoria y se muestra una vez en el log.
INITIAL_SUPERVISOR_NAME=Supervisor
INITIAL_SUPERVISOR_USERNAME=supervisor
INITIAL_SUPERVISOR_PASSWORD=

# --- Despliegue con Docker + Traefik (docker-compose.yml) ---
# Dominio de la app; su registro DNS tipo A debe apuntar a la IP del VPS.
APP_DOMAIN=asistencia.tudominio.cl
# Red de Docker donde está Traefik (ver DEPLOY.md, paso 2).
TRAEFIK_NETWORK=root_default
# Nombres usados por Traefik; los valores por defecto son los de la plantilla n8n de Hostinger.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=mytlschallenge

# --- Plataforma Manus (opcional; solo si se despliega en Manus) ---
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
# MANUS_OAUTH_API_URL=
# MANUS_API_URL=
# MANUS_API_KEY=
# OWNER_OPEN_ID=
